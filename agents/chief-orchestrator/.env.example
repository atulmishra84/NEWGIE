ORCH_ENV=local
ORCH_HOST=0.0.0.0
ORCH_PORT=8090

# Voice providers: stub | openai | deepgram | aws
ORCH_STT_PROVIDER=aws
ORCH_TTS_PROVIDER=aws

# OpenAI (fallback)
ORCH_OPENAI_API_KEY=
ORCH_OPENAI_BASE_URL=https://api.openai.com/v1

# Deepgram (fallback)
ORCH_DEEPGRAM_API_KEY=

# AWS / Bedrock
ORCH_AWS_REGION=us-east-1
ORCH_AWS_ACCESS_KEY_ID=
ORCH_AWS_SECRET_ACCESS_KEY=
ORCH_AWS_SESSION_TOKEN=
ORCH_AWS_POLLY_VOICE_ID=Joanna
ORCH_AWS_POLLY_ENGINE=neural
ORCH_AWS_TRANSCRIBE_BUCKET=
ORCH_BEDROCK_ENABLED=true
ORCH_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
ORCH_BEDROCK_MAX_TOKENS=2048
ORCH_BEDROCK_TEMPERATURE=0.5

# GIE agent URLs
ORCH_CONTEXT_INTELLIGENCE_URL=http://context-intelligence:8080
ORCH_RISK_ASSESSMENT_URL=http://risk-assessment:8091
ORCH_POLICY_ENGINE_URL=http://policy-engine:8092
