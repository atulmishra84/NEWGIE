# GIE Context Intelligence Agent — local development environment

GIE_ENV=local
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://gie:gie@localhost:5432/gie_context

# Redis (cache, Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Neo4j graph projection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=giepassword

# Qdrant evidence vectors
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gie_evidence

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SCAN_REQUESTED=context.scan.requested
KAFKA_CONSUMER_GROUP=context-intelligence

# Auth
JWT_SECRET=local-dev-secret-change-me
JWT_ALGORITHM=HS256
API_KEY_PEPPER=local-pepper

# Rate limiting & caching
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_CACHE_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400

# Feature flags
FLAG_ENABLE_CLOUD_SCANNERS=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Webhooks
GITHUB_WEBHOOK_SECRET=

# CLI / SDK defaults
GIE_API_URL=http://localhost:8080
GIE_API_KEY=
GIE_JWT_TOKEN=

# AWS Bedrock LLM
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
